# Public frontend configuration. Values prefixed with VITE_ are embedded in the browser bundle.
# Do not put credentials, API secrets, or private keys in this file.

# Required for production builds. Include the API version prefix and omit the trailing slash.
VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional. Defaults to the API origin derived from VITE_API_BASE_URL.
# VITE_SOCKET_URL=https://api.example.com

# Optional browser tab title.
VITE_APP_NAME=CampusOryx

# Razorpay Standard Checkout Key ID (Public key for frontend modal, e.g., rzp_test_...)
VITE_RAZORPAY_KEY_ID=rzp_test_TnpXuenJ5WWK2i
