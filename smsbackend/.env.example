# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/edumanage?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
ENABLE_QUEUES=true

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@edumanage.com

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
AI_PROVIDER=gemini

# Razorpay test or live credentials (never expose secret values to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ORDER_TTL_MINUTES=15
PAYMENT_RATE_LIMIT_MAX=20
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
STUDENT_ONLINE_PAYMENTS_ENABLED=true
OFFLINE_PAYMENT_APPROVAL_REQUIRED=false
SCHOOL_NAME=CampusOryx School

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# BullMQ
BULL_REDIS_URL=redis://localhost:6379

# Encryption
BCRYPT_ROUNDS=12
