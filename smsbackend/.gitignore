# ==============================================================================
# EduManage Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Secrets & Environment
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.env.test.example
*.pem
*.key
*.cert
*.crt

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
combined.log
error.log
exceptions.log
rejections.log

# Testing & Coverage
coverage/
.nyc_output/
.temp/
tmp/
**/tmp/
.cache/
.eslintcache

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Prisma & Database
**/node_modules/.prisma/
*.sqlite
*.db
dump.rdb
