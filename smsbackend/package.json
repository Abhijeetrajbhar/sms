{
  "name": "edumanage-backend",
  "version": "1.0.0",
  "description": "AI-assisted School Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "admin:promote": "ts-node src/scripts/promoteSuperAdmin.ts",
    "admin:init": "ts-node src/scripts/bootstrapAdmin.ts",
    "db:clean": "ts-node src/scripts/cleanDatabase.ts",
    "seed": "ts-node src/seed.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test test/integration/*.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.2",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.4",
    "eslint": "^9.27.0",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.33.0"
  }
}
